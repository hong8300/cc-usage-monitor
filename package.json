{
  "name": "cc-usage-monitor",
  "version": "0.1.0",
  "description": "Claude 使用量モニタ — statusLine ブリッジとローカルログから使用量を常時表示する",
  "main": "./out/main/index.js",
  "author": "JUN",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.ts",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac --arm64",
    "icon": "node scripts/generate-icon.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.0.24",
    "electron-vite": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
